  "slider_bar_default": {
    "type": "image",
    "texture": "textures/pyreact_ore/skin/transparent",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "sizing_panel": {
          "type": "panel",
          "size": [
            "100% + 16px",
            "100%"
          ],
          "controls": [
            {
              "slider_background@OreUI.background_default": {
                "layer": 1
              }
            },
            {
              "slider_progress@OreUI.progress_default": {
                "clip_direction": "left",
                "clip_pixelperfect": false,
                "layer": 3
